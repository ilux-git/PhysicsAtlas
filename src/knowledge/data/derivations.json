    "targetEquationId": "eq.newton2.acceleration",
    "steps": [
      {
        "order": 1,
        "description": "Разделим обе части уравнения на массу m (m ≠ 0).",
        "operation": "divide-both-sides",
        "displayFrom": "F = m a",
        "displayTo": "F/m = a",
        "precondition": "m ≠ 0"
      },
      {
        "order": 2,
        "description": "Перепишем равенство, поменяв стороны местами.",
        "operation": "rewrite",
        "displayFrom": "F/m = a",
        "displayTo": "a = F/m"
      }
    ],
    "preconditions": ["cond.nonzero-mass"],
    "verificationStatus": "structural"
